# Device control (set to false for read-only demo deployments)
ACTUATION_ENABLED=true

# S3 / MinIO snapshot storage (defaults match docker/docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=123
S3_SECRET_KEY=abc
S3_BUCKET=swiftlet-alerts

# Telegram bot & webhook settings (keep real values only in git-ignored BackEnd/.env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
