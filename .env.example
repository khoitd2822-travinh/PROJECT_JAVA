# ============================================================================
#  SwiftletCare — Cấu hình mẫu
# ============================================================================
#  Sao chép file này thành `.env` rồi điền giá trị thật:
#      cp .env.example .env
#
#  .env KHÔNG được commit lên git. File .env đã có trong .gitignore.
#  Các giá trị dưới đây là giá trị MẪU cho môi trường dev — không dùng
#  cho môi trường thật.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Database (TimescaleDB / PostgreSQL)
# ---------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/swiftlet
DB_USERNAME=swiftlet
DB_PASSWORD=CHANGE_ME_local_dev_only

# ---------------------------------------------------------------------------
# 2. Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# 3. MQTT Broker (EMQX)
# ---------------------------------------------------------------------------
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=swiftletcare_backend_consumer
# Tenant PHẢI khớp với MQTT_TENANT trong firmware/esp32-main/include/mqtt_config.h
MQTT_TENANT=thanhliem

# ---------------------------------------------------------------------------
# 4. S3 / MinIO (Zenko CloudServer)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME_local_dev_only
S3_SECRET_KEY=CHANGE_ME_local_dev_only
S3_BUCKET_NAME=swiftlet-alerts

# ---------------------------------------------------------------------------
# 5. Bảo mật
# ---------------------------------------------------------------------------
# Bắt buộc đổi ở môi trường thật. Sinh bằng:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_chars
JWT_EXPIRATION_MINUTES=60

# Cho phép các origin gọi API. Liệt kê đầy đủ, không dùng "*" khi deploy thật.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# 6. Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
# URL stream camera để test khi chưa có ESP32-CAM thật
NEXT_PUBLIC_CAMERA_STREAM_URL=http://localhost:5000/video_feed

# ---------------------------------------------------------------------------
# 7. AI service
# ---------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
MODEL_PATH=ai/runs/detect/train/weights/best.pt
CONFIDENCE_THRESHOLD=0.45

# ---------------------------------------------------------------------------
# 8. Thông báo (để trống nếu chưa cấu hình)
# ---------------------------------------------------------------------------
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# 9. Firmware (dùng khi nạp code lên board, không đọc từ backend)
# ---------------------------------------------------------------------------
# WIFI_SSID=
# WIFI_PASSWORD=
# MQTT_BROKER=192.168.1.100
# MQTT_TENANT=thanhliem
